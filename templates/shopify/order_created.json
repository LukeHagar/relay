{
  "v": 1,
  "provider": "shopify",
  "name": "order_created",
  "description": "An order was created in a Shopify store (HMAC over raw body, base64)",
  "signing_hint": "shopify",
  "request": {
    "method": "POST",
    "path": "/webhooks/orders/create",
    "headers": {
      "Content-Type": "application/json",
      "X-Shopify-Topic": "orders/create",
      "X-Shopify-Shop-Domain": "{{shop_domain}}",
      "X-Shopify-Webhook-Id": "{{uuid}}"
    },
    "body": {
      "id": "{{order_id}}",
      "email": "customer@example.com",
      "total_price": "{{total_price}}",
      "currency": "USD",
      "line_items": [
        { "title": "{{item_title}}", "quantity": 1, "price": "{{total_price}}" }
      ],
      "created_at": "{{now_iso}}"
    }
  },
  "defaults": {
    "vars": {
      "order_id": 5107829546119,
      "total_price": "89.00",
      "item_title": "Mechanical Keyboard",
      "shop_domain": "demo-store.myshopify.com"
    }
  }
}
