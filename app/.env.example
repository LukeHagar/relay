# Auth.js
AUTH_SECRET=replace-with-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# WebSocket
WS_PORT=4210

# ECDSA keys (ES256)
WS_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WS_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Frontend
VITE_WS_PORT=4210

